# Host-side tooling only — NEVER compiled into firmware.
# Copy to `.env` (gitignored) and fill in.
#
# The device uses the publishable key with an INSERT-only RLS policy; these
# credentials are the read/delete side, used by the export job.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY_HERE

# Hugging Face dataset archive (phase 4)
HF_TOKEN=hf_YOUR_TOKEN_HERE
HF_DATASET=your-user/govee-readings
# Readings imply room occupancy. Private unless you mean otherwise.
HF_PRIVATE=true
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE
# DDL needs a real Postgres connection, not the API keys.
# Use the POOLER string, not the direct db.<ref>.supabase.co one — that host
# is IPv6-only and unreachable from many networks. See supabase/README.md.
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Dashboard SPA credential (see supabase/mint_dashboard_jwt.py).
# The signing secret stays here; only the minted token ships in the SPA.
SUPABASE_JWT_SECRET=
DASHBOARD_JWT=
