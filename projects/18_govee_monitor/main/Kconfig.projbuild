menu "Govee Monitor"

    config GOVEE_WIFI_SSID
        string "WiFi SSID"
        default "YOUR_SSID_HERE"
        help
            WiFi network used for clock sync and cloud upload. Leave at the
            placeholder to run fully offline — the monitor works without it.

    config GOVEE_WIFI_PASSWORD
        string "WiFi Password"
        default "YOUR_PASSWORD_HERE"
        help
            WiFi network password.

    config GOVEE_DEVICE_ID
        string "Device identifier"
        default "device 1"
        help
            Identifies this board in uploaded rows, and salts the deterministic
            UUIDv7 so two boards watching the same sensor never collide.

    config GOVEE_SUPABASE_URL
        string "Supabase project URL"
        default ""
        help
            e.g. https://abcdefgh.supabase.co — leave empty to disable upload.

    config GOVEE_SUPABASE_KEY
        string "Supabase publishable key"
        default ""
        help
            The sb_publishable_/anon key ONLY, paired with an RLS policy that
            grants INSERT and nothing else. This key ships inside the firmware
            image and can be read back out of flash, so it must not be one that
            can read or delete data.

    config GOVEE_NTP_SERVER
        string "NTP server"
        default "pool.ntp.org"
        help
            Opportunistic time source. Readings are stamped with uptime and
            converted to wall clock only on upload, so a late sync still
            back-dates everything correctly.


    config GOVEE_MAX_SLOTS
        int "Max simultaneous sensors on display"
        range 1 5
        default 3
        help
            Maximum number of H5075 sensors visible at once. Combined with the
            compile-time GOVEE_KNOWN[] table in device_config.h: pinned slots
            come first, remaining slots auto-fill by RSSI.

    config GOVEE_PAUSE_SCAN_IN_POWER_SAVE
        bool "Also stop BLE scanning during power save"
        default n
        help
            Power save always turns the display off. This additionally stops
            the BLE scanner, which saves more current but means no readings are
            recorded while the screen is off — the history simply gains a gap.

            Leave this off if the board is mains-powered and you want an
            unbroken log; turn it on to squeeze battery runtime.

    config GOVEE_STALE_TIMEOUT_S
        int "Stale (grey-out) timeout in seconds"
        default 60
        help
            A slot is greyed out if no advert arrives within this window.

    config GOVEE_EVICT_TIMEOUT_S
        int "Auto-evict timeout for unpinned slots in seconds"
        default 300
        help
            Auto-filled (unpinned) slots are released after this much silence,
            allowing a new device to take their place. Pinned slots are never
            evicted, only greyed.

    config GOVEE_TEMP_UNIT_F
        bool "Display temperature in Fahrenheit"
        default n

endmenu
